@page "/"
@inject ILogger<Home> Logger

<PageTitle>Home</PageTitle>

<div data-testid="counter-value">@counter</div>
<button data-testid="counter-increment" data-umami-event="Counter Button clicked" @onclick="() => counter++">Test</button>
<button @onclick="@(() => Logger.LogInformation("Hit it!"))">Log</button>
<a href="weather">Weather</a>
<a href="diagnostics">Diagnostics</a>

<h1>Hello, world!</h1>

Welcome to your new app.

@code
{
	private int counter;
}