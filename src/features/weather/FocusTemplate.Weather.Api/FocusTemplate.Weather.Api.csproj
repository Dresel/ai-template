<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<ResXGenerator_InternalRegistration>true</ResXGenerator_InternalRegistration>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aigamo.ResXGenerator" PrivateAssets="all" />
		<PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="FluentValidation" />
		<PackageReference Include="Mediator.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\FocusTemplate.Api.Foundation\FocusTemplate.Api.Foundation.csproj" />
		<ProjectReference Include="..\FocusTemplate.Weather.Data\FocusTemplate.Weather.Data.csproj" />
		<ProjectReference Include="..\FocusTemplate.Weather.Shared\FocusTemplate.Weather.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="tspconfig.yaml" />

		<Content Include="openapi.yaml" Link="openapi/weather.yaml" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Remove="**\*.de.resx" />
		<EmbeddedResource Include="**\*.de.resx">
			<DependentUpon>$([System.String]::Copy(%(Filename)).Replace('.de', '.resx'))</DependentUpon>
		</EmbeddedResource>
		<EmbeddedResource Update="**\*.resx">
			<GenerationType>StringLocalizer</GenerationType>
			<ClassNamePostfix>Localizations</ClassNamePostfix>
			<StaticClass>false</StaticClass>
			<StaticMembers>false</StaticMembers>
			<GenerateFormatMethods>true</GenerateFormatMethods>
		</EmbeddedResource>
	</ItemGroup>

</Project>