@using FluentValidation
@inject StationsClient Api
@inject IValidator<Form> FormValidator
@inject IRenameDialogLocalizations L
@inject ApiFailureMessages FailureMessages

<AppForm @ref="appForm" Model="form" Validator="FormValidator" OnValidSubmit="SaveAsync">
	<RadzenStack Gap="1rem">
		<AppFailure Message="@failure" data-testid="station-form-failure" />

		<AppTextInput Label="@L.Name" @bind-Value="form.Name" data-testid="station-name" />

		<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
			<RadzenButton Text="@L.Cancel"
				ButtonStyle="ButtonStyle.Base"
				Variant="Variant.Outlined"
				Click="() => Dialogs.Close()"
				data-testid="cancel-station" />
			<RadzenButton ButtonType="ButtonType.Submit" Text="@L.Save" ButtonStyle="ButtonStyle.Primary" data-testid="save-station" />
		</RadzenStack>
	</RadzenStack>
</AppForm>

@code
{
	private AppForm<Form> appForm = null!;

	private string? failure;

	private Form form = new();

	[Parameter]
	[EditorRequired]
	public StationResponse Station { get; set; } = null!;

	protected override void OnInitialized() => form = Station.ToForm();

	private async Task SaveAsync()
	{
		failure = null;

		// The 403 and 404 the API may still answer are failures here: the page offered the action, so neither is expected
		switch (await Api.RenameAsync(Station.Id, form.ToContract()).ToOutcome<ValidationProblem>())
		{
			case StationResponse saved:
				Dialogs.Close(saved);
				break;

			case ValidationProblem invalid:
				await appForm.ShowServerErrorsAsync(invalid.Problem);
				break;

			case ApiFailure failed:
				failure = FailureMessages.Of(failed);
				break;
		}
	}
}
