<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Directory.Build.props pins the single net11.0 TFM repo-wide; clear it so multi-targeting works. -->
		<TargetFramework></TargetFramework>
		<TargetFrameworks>net11.0-android;net11.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>FocusTemplate.Public.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- Generate C# from XAML at compile time instead of runtime inflation. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>FocusTemplate Mobile</ApplicationTitle>

		<!-- App Identifier: Android package segments must be valid Java identifiers ("public" is a keyword). -->
		<ApplicationId>com.focustemplate.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Version comes from the installed MAUI workload; VersionOverride keeps it in lockstep under CPM. -->
		<PackageReference Include="Microsoft.Maui.Controls" VersionOverride="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FocusTemplate.Public.Mobile.ServiceDefaults\FocusTemplate.Public.Mobile.ServiceDefaults.csproj" />
		<ProjectReference Include="..\FocusTemplate.Public.Shared\FocusTemplate.Public.Shared.csproj" />
	</ItemGroup>

</Project>
