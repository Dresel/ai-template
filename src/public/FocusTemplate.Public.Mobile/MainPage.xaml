<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:shared="clr-namespace:FocusTemplate.Public.Shared;assembly=FocusTemplate.Public.Shared"
	x:Class="FocusTemplate.Public.Mobile.MainPage">

	<Grid Padding="30,20" RowDefinitions="Auto,*" RowSpacing="20">
		<Button
			x:Name="LoadWeatherBtn"
			AutomationId="LoadWeatherButton"
			Text="Load weather"
			SemanticProperties.Hint="Loads the weather forecast from the API"
			Clicked="OnLoadWeatherClicked"
			HorizontalOptions="Fill" />

		<CollectionView
			x:Name="WeatherList"
			AutomationId="WeatherList"
			Grid.Row="1">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="shared:WeatherForecastResponse">
					<Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16" Padding="0,6">
						<Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}" FontAttributes="Bold" />
						<Label Grid.Column="1" Text="{Binding TemperatureC, StringFormat='{0} °C'}" />
						<Label Grid.Column="2" Text="{Binding Summary}" />
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
	</Grid>

</ContentPage>