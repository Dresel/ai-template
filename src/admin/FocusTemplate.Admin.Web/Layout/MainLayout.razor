@using System.Security.Claims
@using FocusTemplate.Admin.Shared
@inherits LayoutComponentBase
@inject NavigationManager Navigation

<RadzenLayout Style="min-height: 100vh;">
	<RadzenHeader data-testid="top-bar">
		<RadzenStack Orientation="Orientation.Horizontal"
			AlignItems="AlignItems.Center"
			JustifyContent="JustifyContent.SpaceBetween"
			Style="padding: 0 1rem;">
			<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
				<RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" data-testid="nav-toggle" />
				<RadzenText TextStyle="TextStyle.H6" TagName="TagName.Span">Viva la Focus</RadzenText>
			</RadzenStack>
			<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
				<RadzenAppearanceToggle LightTheme="standard" DarkTheme="standard-dark" data-testid="theme-toggle" />
				<AuthorizeView>
					<Authorized>
						<RadzenText TagName="TagName.Span" data-testid="user-name">@context.User.Identity?.Name</RadzenText>
						<RadzenButton Icon="logout"
							ButtonStyle="ButtonStyle.Base"
							Variant="Variant.Outlined"
							title="Log out"
							Click="@(() => Logout(context.User))"
							data-testid="logout-button" />
					</Authorized>
				</AuthorizeView>
			</RadzenStack>
		</RadzenStack>
	</RadzenHeader>
	<RadzenSidebar @bind-Expanded="sidebarExpanded" data-testid="nav-bar">
		<RadzenPanelMenu>
			<RadzenPanelMenuItem Text="Home" Icon="home" Path="" data-testid="nav-home" />
			<RadzenPanelMenuItem Text="Weather" Icon="cloud" Path="weather" data-testid="nav-weather" />
			<RadzenPanelMenuItem Text="Diagnostics" Icon="troubleshoot" Path="diagnostics" data-testid="nav-diagnostics" />
		</RadzenPanelMenu>
	</RadzenSidebar>
	<RadzenBody>
		@Body
	</RadzenBody>
</RadzenLayout>

@code
{
	private bool sidebarExpanded = true;

	private void Logout(ClaimsPrincipal user)
	{
		string logoutUrl = user.FindFirst(BffClaimTypes.LogoutUrl)?.Value ??
			throw new InvalidOperationException("Missing bff logout url.");

		Navigation.NavigateTo(logoutUrl, true);
	}
}