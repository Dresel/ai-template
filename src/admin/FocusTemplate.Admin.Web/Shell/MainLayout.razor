@using SpatialFocus.Web.Foundation.Appearance
@using SpatialFocus.Web.Foundation.Localization
@using SpatialFocus.Primitives
@using SpatialFocus.Web.Hosting
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IMainLayoutLocalizations L

<RadzenLayout Style="min-height: 100vh;">
	<RadzenHeader data-testid="top-bar">
		<RadzenStack Orientation="Orientation.Horizontal"
			AlignItems="AlignItems.Center"
			JustifyContent="JustifyContent.SpaceBetween"
			Style="padding: 0 1rem;">
			<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
				<RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" data-testid="nav-toggle" />
				<RadzenText TextStyle="TextStyle.H6" TagName="TagName.Span">Viva la Focus</RadzenText>
			</RadzenStack>
			<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
				<LanguageSwitch />
				<AppearanceSwitch />
				<AccountButtons />
			</RadzenStack>
		</RadzenStack>
	</RadzenHeader>
	<RadzenSidebar @bind-Expanded="sidebarExpanded" data-testid="nav-bar">
		<RadzenPanelMenu>
			<RadzenPanelMenuItem Text="@L.Home" Icon="home" Path="" data-testid="nav-home" />
			<RadzenPanelMenuItem Text="@L.Weather" Icon="cloud" Path="weather" data-testid="nav-weather" />
			<RadzenPanelMenuItem Text="@L.Stations" Icon="sensors" Path="@SpatialFocus.Weather.Web.Stations.ListPage.Path" data-testid="nav-stations" />
			<RadzenPanelMenuItem Text="@L.Validation" Icon="fact_check" Path="demo/validation" data-testid="nav-validation" />
			@* Shown with either of its pages' permissions, so a PermissionView, which asks for one, does not fit *@
			<AuthorizeView>
				@{
					bool users = context.User.Has(UserManagementPermissions.ViewUsers);
					bool groups = context.User.Has(UserManagementPermissions.ViewGroups);
				}
				@if (users || groups)
				{
					<RadzenPanelMenuItem Text="@L.UserManagement" Icon="manage_accounts" data-testid="nav-user-management">
						@if (users)
						{
							<RadzenPanelMenuItem Text="@L.Users" Icon="person" Path="@SpatialFocus.Admin.UserManagement.Web.Users.ListPage.Path" data-testid="nav-users" />
						}
						@if (groups)
						{
							<RadzenPanelMenuItem Text="@L.Groups" Icon="group" Path="@SpatialFocus.Admin.UserManagement.Web.Groups.ListPage.Path" data-testid="nav-groups" />
						}
					</RadzenPanelMenuItem>
				}
			</AuthorizeView>
			<RadzenPanelMenuItem Text="@L.Diagnostics" Icon="troubleshoot" Path="diagnostics" data-testid="nav-diagnostics" />
		</RadzenPanelMenu>
	</RadzenSidebar>
	<RadzenBody>
		@* Blazor reuses a page when only its route values change. The key makes each address a new page with a new view model *@
		<div @key="PagePath">
			@Body
		</div>
	</RadzenBody>
</RadzenLayout>

@code
{
	private bool sidebarExpanded = true;

	// Without the query, so a page that keeps its filters there survives changing them
	private string PagePath => new Uri(Navigation.Uri).AbsolutePath;
}