@using System.Security.Claims
@using FocusTemplate.Admin.Shared
@using FocusTemplate.Admin.Web.Infrastructure.Localization
@using FocusTemplate.Primitives
@using Microsoft.Extensions.Hosting
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IMainLayoutLocalizations L

<RadzenLayout Style="min-height: 100vh;">
	<RadzenHeader data-testid="top-bar">
		<RadzenStack Orientation="Orientation.Horizontal"
			AlignItems="AlignItems.Center"
			JustifyContent="JustifyContent.SpaceBetween"
			Style="padding: 0 1rem;">
			<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
				<RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" data-testid="nav-toggle" />
				<RadzenText TextStyle="TextStyle.H6" TagName="TagName.Span">Viva la Focus</RadzenText>
			</RadzenStack>
			<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
				<LanguageSwitch />
				<RadzenAppearanceToggle LightTheme="software" DarkTheme="software-dark" data-testid="theme-toggle" />
				<AuthorizeView>
					<Authorized>
						<RadzenText TagName="TagName.Span" data-testid="user-name">@context.User.Identity?.Name</RadzenText>
						<RadzenButton Icon="logout"
							ButtonStyle="ButtonStyle.Base"
							Variant="Variant.Outlined"
							title="@L.LogOut"
							Click="@(() => Logout(context.User))"
							data-testid="logout-button" />
					</Authorized>
					<NotAuthorized>
						<RadzenButton Icon="login"
							ButtonStyle="ButtonStyle.Base"
							Variant="Variant.Outlined"
							title="@L.LogIn"
							Click="@Navigation.NavigateToLogin"
							data-testid="login-button" />
					</NotAuthorized>
				</AuthorizeView>
			</RadzenStack>
		</RadzenStack>
	</RadzenHeader>
	<RadzenSidebar @bind-Expanded="sidebarExpanded" data-testid="nav-bar">
		<RadzenPanelMenu>
			<RadzenPanelMenuItem Text="@L.Home" Icon="home" Path="" data-testid="nav-home" />
			<RadzenPanelMenuItem Text="@L.Weather" Icon="cloud" Path="weather" data-testid="nav-weather" />
			<RadzenPanelMenuItem Text="@L.Validation" Icon="fact_check" Path="demo/validation" data-testid="nav-validation" />
			@* Shown with either of its pages' permissions, so a PermissionView, which asks for one, does not fit *@
			<AuthorizeView>
				@{
					bool users = context.User.Has(UserManagementPermissions.ViewUsers);
					bool groups = context.User.Has(UserManagementPermissions.ViewGroups);
				}
				@if (users || groups)
				{
					<RadzenPanelMenuItem Text="@L.UserManagement" Icon="manage_accounts" data-testid="nav-user-management">
						@if (users)
						{
							<RadzenPanelMenuItem Text="@L.Users" Icon="person" Path="@Features.UserManagement.Users.ListPage.Path" data-testid="nav-users" />
						}
						@if (groups)
						{
							<RadzenPanelMenuItem Text="@L.Groups" Icon="group" Path="@Features.UserManagement.Groups.ListPage.Path" data-testid="nav-groups" />
						}
					</RadzenPanelMenuItem>
				}
			</AuthorizeView>
			<RadzenPanelMenuItem Text="@L.Diagnostics" Icon="troubleshoot" Path="diagnostics" data-testid="nav-diagnostics" />
		</RadzenPanelMenu>
	</RadzenSidebar>
	<RadzenBody>
		@* Blazor reuses a page when only its route values change. The key makes each address a new page with a new view model *@
		<div @key="PagePath">
			@Body
		</div>
	</RadzenBody>
</RadzenLayout>

@code
{
	private bool sidebarExpanded = true;

	// Without the query, so a page that keeps its filters there survives changing them
	private string PagePath => new Uri(Navigation.Uri).AbsolutePath;

	private void Logout(ClaimsPrincipal user)
	{
		string logoutUrl = user.FindFirst(BffClaimTypes.LogoutUrl)?.Value ??
							throw new InvalidOperationException("Missing bff logout url.");

		Navigation.NavigateTo(logoutUrl, true);
	}
}