@page "/"
@attribute [AllowAnonymous]
@inject ILogger<Home> Logger
@inject NotificationService Notifications
@inject IHomeLocalizations L

<PageTitle>@L.Title</PageTitle>

<RadzenStack Gap="1rem">
	<RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1">@L.Welcome</RadzenText>

	<RadzenCard>
		<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">@L.TemplateTitle</RadzenText>
		<RadzenText TextStyle="TextStyle.Subtitle1">@L.TemplateSubtitle</RadzenText>
		<RadzenText TextStyle="TextStyle.Body1">@L.TemplateText</RadzenText>
	</RadzenCard>

	<RadzenCard>
		<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">@L.Playground</RadzenText>
		<RadzenStack Gap="1rem">
			<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
				<RadzenText TagName="TagName.Span">@L.Counter</RadzenText>
				<RadzenBadge BadgeStyle="BadgeStyle.Primary" data-testid="counter-value">@counter</RadzenBadge>
			</RadzenStack>
			<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
				<RadzenButton Text="@L.Count"
					ButtonStyle="ButtonStyle.Primary"
					Click="() => counter++"
					data-testid="counter-increment"
					data-umami-event="Counter Button clicked" />
				<RadzenButton Text="@L.Log" ButtonStyle="ButtonStyle.Secondary" Click="LogClicked" />
			</RadzenStack>
		</RadzenStack>
	</RadzenCard>
</RadzenStack>

@code
{
	private int counter;

	private void LogClicked()
	{
		Logger.LogInformation("Hit it!");

		Notifications.Notify(NotificationSeverity.Info, L.Logged, L.LoggedDetail);
	}
}