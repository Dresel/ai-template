@using System.Reflection
@using FocusTemplate.Admin.Web.Infrastructure.Authentication
@inject IAppLocalizations L

<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="FeatureAssemblies" NotFoundPage="typeof(NotFound)">
	<Found Context="routeData">
		<AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
			<NotAuthorized>
				@if (context.User.Identity?.IsAuthenticated == true)
				{
					<Forbidden />
				}
				else
				{
					<RedirectToLogin />
				}
			</NotAuthorized>
			<Authorizing>
				<p data-testid="authorizing">@L.CheckingSession</p>
			</Authorizing>
		</AuthorizeRouteView>
		<FocusOnNavigate RouteData="@routeData" Selector="h1" />
	</Found>
</Router>

<HeadContent>
	<RadzenTheme Theme="software" />
</HeadContent>
<RadzenComponents />

@code
{
	// The pages of the features this host includes
	private static readonly Assembly[] FeatureAssemblies = [typeof(Weather.Web.ServiceCollectionExtensions).Assembly,];
}