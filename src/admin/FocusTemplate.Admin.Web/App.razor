@using System.Reflection
@using FocusTemplate.Admin.Web.Foundation.Pages
@using FocusTemplate.Admin.Web.Infrastructure.Authentication
@inject IAppLocalizations L
@inject IEnumerable<PageAssembly> PageAssemblies

<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="additionalAssemblies" NotFoundPage="typeof(NotFound)">
	<Found Context="routeData">
		<AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
			<NotAuthorized>
				@if (context.User.Identity?.IsAuthenticated == true)
				{
					<Forbidden />
				}
				else
				{
					<RedirectToLogin />
				}
			</NotAuthorized>
			<Authorizing>
				<p data-testid="authorizing">@L.CheckingSession</p>
			</Authorizing>
		</AuthorizeRouteView>
		<FocusOnNavigate RouteData="@routeData" Selector="h1" />
	</Found>
</Router>

<HeadContent>
	<RadzenTheme Theme="software" />
</HeadContent>
<RadzenComponents />

@code
{
	// The pages of the features this host includes, which each feature registers along with its other services
	private Assembly[] additionalAssemblies = [];

	protected override void OnInitialized() =>
		additionalAssemblies = [.. PageAssemblies.Select(pages => pages.Assembly).Distinct(),];
}