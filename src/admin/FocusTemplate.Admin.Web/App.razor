@using FocusTemplate.Admin.Web.Infrastructure.Authentication
<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(NotFound)">
	<Found Context="routeData">
		<AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
			<NotAuthorized>
				@if (context.User.Identity?.IsAuthenticated == true)
				{
					<Forbidden />
				}
				else
				{
					<RedirectToLogin />
				}
			</NotAuthorized>
			<Authorizing>
				<p data-testid="authorizing">Checking your session...</p>
			</Authorizing>
		</AuthorizeRouteView>
		<FocusOnNavigate RouteData="@routeData" Selector="h1" />
	</Found>
</Router>

<HeadContent>
	<RadzenTheme Theme="software" />
</HeadContent>
<RadzenComponents />