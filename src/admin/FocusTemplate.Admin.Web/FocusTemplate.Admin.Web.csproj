<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Enable WASM diagnostics so client OpenTelemetry can collect metrics and distributed traces. -->
		<MetricsSupport>true</MetricsSupport>
		<EventSourceSupport>true</EventSourceSupport>

		<!-- Enable Activity/DiagnosticSource support for distributed tracing -->
		<HttpActivityPropagationSupport>true</HttpActivityPropagationSupport>
	</PropertyGroup>

	<ItemGroup>
		<RuntimeHostConfigurationOption Include="System.Net.Http.EnableActivityPropagation">
			<Value>true</Value>
		</RuntimeHostConfigurationOption>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Radzen.Blazor" />
		<PackageReference Include="Aigamo.ResXGenerator" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Localization" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" />
		<PackageReference Include="Riok.Mapperly" ExcludeAssets="runtime" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FocusTemplate.Admin.Client\FocusTemplate.Admin.Client.csproj" />
		<ProjectReference Include="..\FocusTemplate.Admin.Shared\FocusTemplate.Admin.Shared.csproj" />
		<ProjectReference Include="..\FocusTemplate.Admin.Web.ClientServiceDefaults\FocusTemplate.Admin.Web.ClientServiceDefaults.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Remove="**\*.de.resx" />
		<EmbeddedResource Include="**\*.de.resx">
			<DependentUpon>$([System.String]::Copy(%(Filename)).Replace('.de', '.resx'))</DependentUpon>
		</EmbeddedResource>
		<EmbeddedResource Update="**\*.resx">
			<GenerationType>StringLocalizer</GenerationType>
			<ClassNamePostfix>Localizations</ClassNamePostfix>
			<StaticClass>false</StaticClass>
			<StaticMembers>false</StaticMembers>
			<GenerateFormatMethods>true</GenerateFormatMethods>
		</EmbeddedResource>

		<!-- Read by key, one per permission, through IStringLocalizer<PermissionLabels> -->
		<EmbeddedResource Update="Features\UserManagement\PermissionLabels.resx">
			<SkipFile>true</SkipFile>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="FocusTemplate.Admin.Web.UnitTests" />
	</ItemGroup>

</Project>