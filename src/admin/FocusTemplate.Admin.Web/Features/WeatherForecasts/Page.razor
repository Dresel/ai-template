@page "/weather"
@using FocusTemplate.Admin.Client.WeatherForecasts
@using FocusTemplate.Admin.Shared
@inject WeatherForecastsClient Api

<PageTitle>Weather</PageTitle>

<RadzenStack Gap="1rem">
	<RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1">Weather</RadzenText>

	<RadzenCard>
		<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">Five-day forecast</RadzenText>
		@if (Forecasts is null)
		{
			<RadzenText data-testid="weather-loading">Loading...</RadzenText>
		}
		else
		{
			<RadzenTable AllowAlternatingRows="true" data-testid="weather-table">
				<RadzenTableHeader>
					<RadzenTableHeaderRow>
						<RadzenTableHeaderCell>Date</RadzenTableHeaderCell>
						<RadzenTableHeaderCell>Temp. (C)</RadzenTableHeaderCell>
						<RadzenTableHeaderCell>Temp. (F)</RadzenTableHeaderCell>
						<RadzenTableHeaderCell>Summary</RadzenTableHeaderCell>
					</RadzenTableHeaderRow>
				</RadzenTableHeader>
				<RadzenTableBody>
					@foreach (WeatherForecastResponse forecast in Forecasts)
					{
						<RadzenTableRow data-testid="weather-row">
							<RadzenTableCell>@forecast.Date.ToShortDateString()</RadzenTableCell>
							<RadzenTableCell>@forecast.TemperatureC</RadzenTableCell>
							<RadzenTableCell>@forecast.TemperatureF</RadzenTableCell>
							<RadzenTableCell>@forecast.Summary</RadzenTableCell>
						</RadzenTableRow>
					}
				</RadzenTableBody>
			</RadzenTable>
		}
	</RadzenCard>
</RadzenStack>

@code
{
	private IReadOnlyList<WeatherForecastResponse>? Forecasts { get; set; }

	protected override async Task OnInitializedAsync()
	{
		Forecasts = await Api.ListAsync();
	}
}