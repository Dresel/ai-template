@page "/demo/validation"
@using FluentValidation
@using FocusTemplate.Admin.Client
@using FocusTemplate.Admin.Client.DemoProfiles
@using FocusTemplate.Admin.Shared
@inject DemoProfilesClient Api
@inject IValidator<Form> FormValidator
@inject IPageLocalizations L
@inject ApiFailureMessages FailureMessages

<PageTitle>@L.Title</PageTitle>

<RadzenStack Gap="1rem">
	<RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1">@L.Title</RadzenText>

	<RadzenCard>
		<RadzenText TextStyle="TextStyle.Body1">@L.Intro</RadzenText>
		<ul>
			<li>@Hint(L.HintCodeTaken, "TAK")</li>
			<li>@Hint(L.HintNameReserved, "Reserved")</li>
			<li>@L.HintSeverities</li>
			<li>@Hint(L.HintAtlantis, "Atlantis")</li>
			<li>@L.HintBrowserChecks</li>
		</ul>
	</RadzenCard>

	<RadzenCard>
		<RadzenStack Gap="1rem">
			<RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="2rem">
				<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
					<RadzenSwitch @bind-Value="form.ClientRules"
						@bind-Value:after="ClientRulesChangedAsync"
						Name="client-rules"
						data-testid="client-rules" />
					<RadzenLabel Text="@L.CheckInBrowser" Component="client-rules" />
				</RadzenStack>
				<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
					<RadzenSwitch @bind-Value="showOptional" Name="show-optional" data-testid="show-optional" />
					<RadzenLabel Text="@L.ShowOptional" Component="show-optional" />
				</RadzenStack>
			</RadzenStack>

			<AppForm @ref="appForm"
				Model="form"
				Validator="FormValidator"
				Renames="Mapper.Renames"
				OnValidSubmit="SubmitAsync">
				<RadzenStack Gap="1rem">
					@if (accepted is not null)
					{
						<RadzenAlert AlertStyle="AlertStyle.Success" Shade="Shade.Lighter" AllowClose="false" data-testid="accepted">
							@L.Accepted(accepted.Code, accepted.Name)
						</RadzenAlert>
					}
					<AppFailure Message="@failure" data-testid="submit-failure" />

					<div class="app-fields">
						<AppTextInput Label="@L.Code" @bind-Value="form.Code" data-testid="code" />
						<AppTextInput Label="@L.Name" @bind-Value="form.DisplayName" data-testid="name" />
						<AppNumericInput Label="@L.Age" @bind-Value="form.Age" data-testid="age" />
					</div>

					@if (showOptional)
					{
						<div class="app-fields">
							<AppTextInput Label="@L.Nickname" @bind-Value="form.Nickname" data-testid="nickname" />
							<AppNumericInput Label="@L.Weight" @bind-Value="form.WeightKg" data-testid="weight" />
							<AppNumericInput Label="@L.LowestTemperature" @bind-Value="form.MinTemperatureC" data-testid="min-temperature" />
							<AppNumericInput Label="@L.HighestTemperature" @bind-Value="form.MaxTemperatureC" data-testid="max-temperature" />
						</div>
					}

					<div class="app-fields">
						<AppTextInput Label="@L.Street" @bind-Value="form.Address.Street" data-testid="street" />
						<AppTextInput Label="@L.PostalCode" @bind-Value="form.Address.PostalCode" data-testid="postal-code" />
						<AppTextInput Label="@L.City" @bind-Value="form.Address.City" data-testid="city" />
					</div>

					<RadzenStack Gap="0.5rem" AlignItems="AlignItems.Start">
						<RadzenLabel Text="@L.Tags" />
						@foreach ((TagRow tag, int index) in form.Tags.Select((tag, index) => (tag, index)))
						{
							<RadzenStack @key="tag"
								Orientation="Orientation.Horizontal"
								AlignItems="AlignItems.Start"
								Gap="0.5rem"
								data-testid="tag-row">
								<AppTextInput @bind-Value="tag.Value" Path="@($"Tags[{index}]")" data-testid="@($"tag-{index}")" />
								<RadzenButton Icon="delete"
									ButtonStyle="ButtonStyle.Base"
									Variant="Variant.Outlined"
									title="@L.RemoveTag"
									Click="() => RemoveTagAsync(tag)"
									data-testid="@($"remove-tag-{index}")" />
							</RadzenStack>
						}
						<AppFieldMessages For="() => form.Tags" data-testid="tags" />
						<RadzenButton Text="@L.AddTag"
							ButtonStyle="ButtonStyle.Base"
							Variant="Variant.Outlined"
							Click="AddTagAsync"
							data-testid="add-tag" />
					</RadzenStack>

					<RadzenStack Orientation="Orientation.Horizontal">
						<RadzenButton ButtonType="ButtonType.Submit" Text="@L.Submit" ButtonStyle="ButtonStyle.Primary" data-testid="submit" />
					</RadzenStack>
				</RadzenStack>
			</AppForm>
		</RadzenStack>
	</RadzenCard>
</RadzenStack>

@code
{
	private readonly Form form = new();

	private AcceptedProfile? accepted;

	private AppForm<Form> appForm = null!;

	private string? failure;

	private bool showOptional = true;

	// A hint with its sample value as code, which the translations place where it fits their sentence. The page's own
	// texts count as markup, as with ASP.NET Core's IHtmlLocalizer.
	private static MarkupString Hint(Func<object, string> text, string value) => new(text($"<code>{value}</code>"));

	private async Task AddTagAsync()
	{
		form.Tags.Add(new TagRow());
		await appForm.NotifyFieldChangedAsync(FieldIdentifier.Create(() => form.Tags));
	}

	// Flipping the demo's switch changes what the form's rules find
	private Task ClientRulesChangedAsync() => appForm.NotifyFieldChangedAsync(FieldIdentifier.Create(() => form.ClientRules));

	private async Task RemoveTagAsync(TagRow tag)
	{
		form.Tags.Remove(tag);
		await appForm.NotifyFieldChangedAsync(FieldIdentifier.Create(() => form.Tags));
	}

	private async Task SubmitAsync()
	{
		accepted = null;
		failure = null;

		switch (await Api.CreateAsync(form.ToContract()).ToOutcome<ValidationProblem>())
		{
			case DemoProfileResponse profile:
				accepted = profile.ToAcceptedProfile();
				await appForm.ClearServerErrorsAsync();
				break;

			case ValidationProblem invalid:
				await appForm.ShowServerErrorsAsync(invalid.Problem);
				break;

			case ApiFailure failed:
				failure = FailureMessages.Of(failed);
				break;
		}
	}
}