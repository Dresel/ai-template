@attribute [Route("/" + ListPage.Path + "/{Id:guid}")]
@attribute [RequiresPermission(UserManagementPermissions.Names.ViewUsers)]
@inherits ViewModelPage<DetailPageViewModel>
@inject IDetailPageLocalizations L

<RadzenStack Gap="1rem">
	<AppFailure Message="@ViewModel.Failure" data-testid="user-failure" />

	<AppItemView TItem="UserResponse"
		Item="ViewModel.User"
		Loading="ViewModel.Loading"
		Missing="ViewModel.Missing"
		Title="UserResponseTitle"
		Fallback="@L.Fallback"
		MissingTitle="@L.Missing"
		BackPath="@ListPage.Path"
		BackText="@L.AllUsers"
		TestId="user"
		Context="user">
		<RadzenStack Orientation="Orientation.Horizontal"
			AlignItems="AlignItems.Center"
			JustifyContent="JustifyContent.SpaceBetween"
			Wrap="FlexWrap.Wrap">
			<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
				<RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1" data-testid="user-title">@user.DisplayName</RadzenText>
				<RadzenBadge BadgeStyle="@(user.IsActive ? BadgeStyle.Success : BadgeStyle.Light)"
					Text="@(user.IsActive ? L.Active : L.Deactivated)"
					data-testid="user-status" />
			</RadzenStack>
			@* Self deactivating not supported by the API *@
			@if (CanManageUsers && !Self)
			{
				@if (user.IsActive)
				{
					<RadzenButton Text="@L.Deactivate"
						Icon="person_off"
						ButtonStyle="ButtonStyle.Danger"
						Variant="Variant.Outlined"
						Disabled="ViewModel.SettingActive"
						Click="DeactivateAsync"
						data-testid="deactivate-user" />
				}
				else
				{
					<RadzenButton Text="@L.Activate"
						Icon="person_check"
						ButtonStyle="ButtonStyle.Base"
						Variant="Variant.Outlined"
						Disabled="ViewModel.SettingActive"
						Click="ViewModel.ActivateAsync"
						data-testid="activate-user" />
				}
			}
		</RadzenStack>

		<RadzenCard>
			<RadzenStack Gap="0.5rem">
				<RadzenText TextStyle="TextStyle.Body1" data-testid="user-email">@(user.Email ?? L.NoEmail)</RadzenText>
				<RadzenText TextStyle="TextStyle.Body2">
					@L.Seen(user.FirstSeenAt.ToLocalTime(), user.LastSeenAt.ToLocalTime())
				</RadzenText>
			</RadzenStack>
		</RadzenCard>

		<RadzenCard>
			<RadzenStack Gap="0.5rem" data-testid="user-groups">
				<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">@L.Groups</RadzenText>
				@if (user.Groups.Count == 0)
				{
					<RadzenText TextStyle="TextStyle.Body2">@L.NoGroups</RadzenText>
				}
				@foreach (GroupReferenceResponse group in user.Groups)
				{
					<RadzenLink @key="group.Id"
						Path="@Groups.DetailPage.PathOf(group.Id)"
						Text="@group.Name"
						data-testid="user-group" />
				}
			</RadzenStack>
		</RadzenCard>

		<RadzenCard>
			<RadzenStack Gap="0.5rem" data-testid="user-permissions">
				<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">@L.Permissions</RadzenText>
				@if (!user.IsActive)
				{
					<RadzenText TextStyle="TextStyle.Body2">@L.DeactivatedNote</RadzenText>
				}
				@foreach (IGrouping<string, PermissionLabel> section in user.Permissions.Select(PermissionLabels.Of).GroupBy(label => label.Section))
				{
					<RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H3">@section.Key</RadzenText>
					<ul>
						@foreach (PermissionLabel label in section)
						{
							<li @key="label">@label.Action</li>
						}
					</ul>
				}
			</RadzenStack>
		</RadzenCard>
	</AppItemView>
</RadzenStack>

@code
{
	public static string PathOf(UserId user) => $"{ListPage.Path}/{user.Value}";

	private static string UserResponseTitle(UserResponse user) => user.DisplayName;

	[Parameter]
	public Guid Id { get; set; }

	private bool CanManageUsers => CurrentUser.Has(UserManagementPermissions.ManageUsers);

	private bool Self => CurrentUser.Id == UserId.From(Id);

	protected override Task OnInitializedAsync() => ViewModel.LoadAsync(UserId.From(Id));

	private async Task DeactivateAsync()
	{
		if (await Dialogs.ConfirmAsync(L.ConfirmDeactivate(ViewModel.User!.DisplayName), L.DeactivateUser, L.Deactivate))
		{
			await ViewModel.DeactivateAsync();
		}
	}
}