@page "/"
@inject ILogger<Home> Logger
@inject NotificationService Notifications

<PageTitle>Home</PageTitle>

<RadzenStack Gap="1rem">
	<RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1">Welcome</RadzenText>

	<RadzenCard>
		<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">AI-first .NET template</RadzenText>
		<RadzenText TextStyle="TextStyle.Subtitle1">Where your journey begins</RadzenText>
		<RadzenText TextStyle="TextStyle.Body1">
			Blazor WebAssembly behind a thin BFF, orchestrated by Aspire — with a TLS-offloading
			ingress, end-to-end OpenTelemetry, Umami analytics, and Playwright E2E tests.
		</RadzenText>
	</RadzenCard>

	<RadzenCard>
		<RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">Playground</RadzenText>
		<RadzenStack Gap="1rem">
			<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
				<RadzenText TagName="TagName.Span">Counter:</RadzenText>
				<RadzenBadge BadgeStyle="BadgeStyle.Primary" data-testid="counter-value">@counter</RadzenBadge>
			</RadzenStack>
			<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
				<RadzenButton Text="Count"
					ButtonStyle="ButtonStyle.Primary"
					Click="() => counter++"
					data-testid="counter-increment"
					data-umami-event="Counter Button clicked" />
				<RadzenButton Text="Log" ButtonStyle="ButtonStyle.Secondary" Click="LogClicked" />
			</RadzenStack>
		</RadzenStack>
	</RadzenCard>
</RadzenStack>

@code
{
	private int counter;

	private void LogClicked()
	{
		Logger.LogInformation("Hit it!");

		Notifications.Notify(NotificationSeverity.Info, "Logged", "Logged a message — see the dashboard's structured logs.");
	}
}