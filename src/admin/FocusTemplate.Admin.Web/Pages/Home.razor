@page "/"
@inject ILogger<Home> Logger
@inject IToastService ToastService

<PageTitle>Home</PageTitle>

<Heading Size="HeadingSize.Is1" Margin="Margin.Is3.FromBottom">Welcome</Heading>

<Card Margin="Margin.Is3.FromBottom">
	<CardBody>
		<CardTitle Size="HeadingSize.Is5">AI-first .NET template</CardTitle>
		<CardSubtitle>Where your journey begins</CardSubtitle>
		<CardText>
			Blazor WebAssembly behind a thin BFF, orchestrated by Aspire — with a TLS-offloading
			ingress, end-to-end OpenTelemetry, Umami analytics, and Playwright E2E tests.
		</CardText>
	</CardBody>
</Card>

<Card>
	<CardBody>
		<CardTitle Size="HeadingSize.Is5">Playground</CardTitle>
		<CardText>
			<Paragraph>
				Counter: <Badge Color="Color.Primary" data-testid="counter-value">@counter</Badge>
			</Paragraph>
			<Button Color="Color.Primary" data-testid="counter-increment" data-umami-event="Counter Button clicked" Clicked="() => counter++">Count</Button>
			<Button Color="Color.Secondary" Clicked="@OnLogClickedAsync">Log</Button>
		</CardText>
	</CardBody>
</Card>

@code
{
	private int counter;

	private async Task OnLogClickedAsync()
	{
		Logger.LogInformation("Hit it!");

		await ToastService.Info("Logged a message — see the dashboard's structured logs.", "Logged");
	}
}