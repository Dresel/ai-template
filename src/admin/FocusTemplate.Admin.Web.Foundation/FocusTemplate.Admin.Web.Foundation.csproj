<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<ResXGenerator_InternalRegistration>true</ResXGenerator_InternalRegistration>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Radzen.Blazor" />
		<PackageReference Include="Aigamo.ResXGenerator" PrivateAssets="all" />
		<PackageReference Include="FluentValidation" />
		<PackageReference Include="Microsoft.Extensions.Localization" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\FocusTemplate.Http\FocusTemplate.Http.csproj" />
		<ProjectReference Include="..\..\FocusTemplate.Primitives\FocusTemplate.Primitives.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Remove="**\*.de.resx" />
		<EmbeddedResource Include="**\*.de.resx">
			<DependentUpon>$([System.String]::Copy(%(Filename)).Replace('.de', '.resx'))</DependentUpon>
		</EmbeddedResource>
		<EmbeddedResource Update="**\*.resx">
			<GenerationType>StringLocalizer</GenerationType>
			<ClassNamePostfix>Localizations</ClassNamePostfix>
			<StaticClass>false</StaticClass>
			<StaticMembers>false</StaticMembers>
			<GenerateFormatMethods>true</GenerateFormatMethods>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="FocusTemplate.Admin.Web.UnitTests" />
	</ItemGroup>

</Project>