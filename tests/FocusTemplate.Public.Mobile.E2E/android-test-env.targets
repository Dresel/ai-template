<?xml version="1.0" encoding="utf-8"?>
<!--
  Injected via -p:CustomAfterMicrosoftCommonTargets when the E2E fixture builds/installs the APK.
  Bakes the test environment into the app (same AndroidEnvironment mechanism Aspire.Hosting.Maui
  uses): service discovery resolves public-api to localhost:5210, which `adb reverse` maps to the
  test AppHost's real port. No OTEL_EXPORTER_OTLP_ENDPOINT -> the OTLP exporter stays disabled.
  Reuses the __aspire_environment__.txt file name so a later Aspire-driven build cleanly replaces it.
-->
<Project>
	<ItemGroup>
		<_TestAndroidEnvironment Include="SERVICES__PUBLIC-API__HTTP__0=http://localhost:5210" />
	</ItemGroup>
	<Target Name="FocusTemplateTestAndroidEnvironment" BeforeTargets="_GenerateEnvironmentFiles" Condition="'@(_TestAndroidEnvironment)' != ''">
		<WriteLinesToFile File="$(IntermediateOutputPath)__aspire_environment__.txt" Lines="@(_TestAndroidEnvironment)" Overwrite="True" WriteOnlyWhenDifferent="True" />
		<ItemGroup>
			<AndroidEnvironment Include="$(IntermediateOutputPath)__aspire_environment__.txt" />
			<FileWrites Include="$(IntermediateOutputPath)__aspire_environment__.txt" />
		</ItemGroup>
		<Delete Files="$(_AndroidStampDirectory)_GeneratePackageManagerJava.stamp" />
	</Target>
</Project>
