<?xml version="1.0" encoding="utf-8"?>

<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<!-- Packages built locally from a fix that awaits its upstream release, see .claude/rules/packages.md -->
		<add key="local" value=".nuget" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="local">
			<package pattern="Aigamo.ResXGenerator" />
		</packageSource>
	</packageSourceMapping>
</configuration>